# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# ⚠️ NEVER commit .env.local to version control!

# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# MongoDB Connection String (Optional - for caching)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
# MONGODB_URI=your_mongodb_connection_string_here

# Vercel OIDC Token (Optional - auto-generated by Vercel CLI)
# VERCEL_OIDC_TOKEN=auto_generated_by_vercel_cli
