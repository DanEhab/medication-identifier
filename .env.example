# ---------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.
# ---------------------------------------------------------------

# REQUIRED. Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL. MongoDB Atlas connection string used to cache drug lookups.
# Leave blank to run without caching — every lookup then hits Gemini directly.
MONGODB_URI=

# OPTIONAL. Comma-separated origins allowed to call the API.
# Leave blank in local dev. In production set this to your own domain(s).
ALLOWED_ORIGINS=

# OPTIONAL. Point the frontend at a different backend.
# Leave blank to use same-origin /api (correct for both `npm run dev` and Vercel).
VITE_API_BASE_URL=

# ---------------------------------------------------------------
# Rate limiting. All optional — the defaults below are what runs.
# ---------------------------------------------------------------

# Lookups per minute, per caller. Each one can cost an AI call.
RATE_LIMIT_GENERATE_PER_MINUTE=20

# Translations per minute, per caller. An Arabic page fires roughly ten
# at once, so this is deliberately much higher.
RATE_LIMIT_TRANSLATE_PER_MINUTE=150

# Whole-app ceiling on AI calls per day. This is the budget guard.
# Cached medicines keep working after it is reached.
RATE_LIMIT_PER_DAY=2000

# Salt for hashing caller addresses. Set a private value in production;
# addresses are never stored in the clear either way.
RATE_LIMIT_SALT=
